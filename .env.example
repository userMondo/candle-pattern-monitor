# Candle Pattern Monitor — Environment Configuration Template
#
# Copy this file to .env and fill in your values, OR
# set these as GitHub Actions secrets/env vars.
#
# This file is NOT committed to the repo (see .gitignore).

# Telegram Bot Configuration
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat ID (get it by messaging @userinfobot)
# TELEGRAM_CHAT_ID=your_chat_id_here

# Binance API Key (optional — only used for higher rate limits on public endpoints)
# BINANCE_API_KEY=your_binance_api_key_here

# Watchlist: comma-separated trading pairs
WATCHLIST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Default interval (1h or 4h)
INTERVAL=4h

# Number of candles to fetch per symbol
CANDLE_LIMIT=50
