# Candle Pattern Monitor — Environment Configuration Template
#
# Copy this file to .env and fill in your values, OR
# set these as GitHub Actions secrets/env vars.
#
# This file is NOT committed to the repo (see .gitignore).

# Telegram Bot Configuration
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat ID (message @jiodsjfiebot with /start, then run
# python3 src/get_chat_id.py --token YOUR_TOKEN)
# TELEGRAM_CHAT_ID=your_chat_id_here

# Binance API Key (optional — only used for higher rate limits on public endpoints)
# BINANCE_API_KEY=your_binance_api_key_here

# Watchlist: comma-separated trading pairs
# Supported: BTCUSDT, NEARUSDT, ZECUSDT, PAXGUSDT (gold-backed), and any Binance USDT pair
WATCHLIST_SYMBOLS=BTCUSDT,NEARUSDT,ZECUSDT,PAXGUSDT

# Default interval (15m primary, 1h and 4h also supported)
INTERVAL=15m

# Pattern focus: leave empty for ALL patterns, or comma-separate:
# engulfing, doji, pinbar, hammer, shooting_star, morning_star, evening_star
PATTERN_FOCUS=

# Number of candles to fetch per symbol
CANDLE_LIMIT=50
